# ─── Derive settings ──────────────────────────────────────────
# Number of addresses to derive per mnemonic
DERIVE_COUNT=1
DERIVE_PATH=m/44'/60'/0'/0

# ─── Fetch mode (selected interactively at runtime) ───────────
#   1. Balance          → Balance across all chains
#   2. Balance by Chain → Balance broken down per chain
#   3. Balance Defi     → Balance + DeFi protocol breakdown

# ─── Currency ─────────────────────────────────────────────────
CURRENCY=usd

# ─── Filter results ───────────────────────────────────────────
# Only save wallets with balance above this value (in USD)
MIN_BALANCE=1

# ─── Concurrency ──────────────────────────────────────────────
# BROWSER_COUNT = number of browsers running simultaneously
# CONCURRENCY   = number of parallel tabs per browser
# Total parallel = BROWSER_COUNT × CONCURRENCY
# Example: BROWSER_COUNT=2, CONCURRENCY=3 → 6 addresses processed at once
BROWSER_COUNT=1
CONCURRENCY=3
